# Shell scripts must keep LF endings — a CRLF deploy.sh checked out on the EC2
# host fails with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf
# Vendored third-party files are shipped byte for byte (jassubAssets.test.js compares them with the package):
# never convert their line endings on a Windows checkout.
public/vendor/** -text
