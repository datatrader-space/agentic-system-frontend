{
 "steps": [
  {
   "type": "media.generate",
   "category": "media",
   "label": "Generate media",
   "sub": "Review a Studio estimate before spending",
   "order": 0,
   "trigger": false,
   "executable": true,
   "billable": true,
   "custom": false,
   "palette": true,
   "custom_tail": "",
   "defaults": {
    "operation": "image",
    "route_id": "",
    "prompt": "",
    "params": {},
    "references": [],
    "cinema": {}
   },
   "fields": [
    {
     "key": "operation",
     "type": "enum",
     "title": "Operation",
     "options": [
      "image",
      "video",
      "edit_image",
      "speech",
      "sound",
      "music",
      "sfx",
      "upscale",
      "lipsync",
      "motion",
      "avatar",
      "voice_change",
      "transcribe"
     ]
    },
    {
     "key": "route_id",
     "type": "media-route",
     "title": "Model"
    },
    {
     "key": "prompt",
     "type": "textarea",
     "title": "Prompt",
     "insertable": true
    },
    {
     "key": "params_json",
     "type": "textarea",
     "title": "Parameters (JSON)",
     "mono": true
    },
    {
     "key": "references_json",
     "type": "textarea",
     "title": "References (JSON array)",
     "mono": true,
     "help": "[{\"attachment_id\":\"{{nodes.id.attachment_id}}\",\"role\":\"subject\"}]"
    },
    {
     "key": "cinema_json",
     "type": "textarea",
     "title": "Cinema (JSON)",
     "mono": true,
     "showIf": {
      "operation": "video"
     }
    }
   ],
   "hint": "The run waits on a job approval card. Generate authorizes only that job; Decline stops the run.",
   "output_sample": {
    "attachment_id": "(attachment)",
    "url": "(url)",
    "extra_attachment_ids": []
   },
   "outputs": {
    "attachment_id": {
     "kind": "text",
     "description": "the media result's attachment id"
    },
    "url": {
     "kind": "text",
     "description": "the media result's address"
    },
    "extra_attachment_ids": {
     "kind": "list",
     "description": "more results of the same job"
    }
   },
   "inputs": {}
  },
  {
   "type": "trigger.manual",
   "category": "trigger",
   "label": "Manual trigger",
   "sub": "Runs on demand",
   "order": 1,
   "trigger": true,
   "executable": true,
   "billable": false,
   "custom": false,
   "palette": true,
   "custom_tail": "",
   "defaults": {},
   "fields": [
    {
     "type": "note",
     "text": "Manual triggers run when you press Run. Declare inputs to be prompted at run time; reference them as {{trigger.key}}. An image input asks for a photo."
    },
    {
     "key": "inputs",
     "type": "kv",
     "title": "Inputs",
     "addLabel": "+ Add input",
     "cols": [
      {
       "key": "key",
       "ph": "key",
       "mono": true
      },
      {
       "key": "type",
       "ph": "type",
       "options": [
        [
         "text",
         "Text"
        ],
        [
         "image",
         "Image"
        ]
       ]
      },
      {
       "key": "default",
       "ph": "default (optional)"
      }
     ]
    }
   ],
   "hint": "",
   "output_sample": null,
   "outputs": {
    "text": {
     "kind": "text",
     "description": "empty"
    },
    "trigger": {
     "kind": "object",
     "description": "the run's inputs: each declared input by its key (an image input is an image)"
    }
   },
   "inputs": {}
  },
  {
   "type": "trigger.schedule",
   "category": "trigger",
