    "text": "agent reply text",
    "agent": "Agent name"
   },
   "outputs": {
    "text": {
     "kind": "text",
     "description": "the agent's answer"
    },
    "agent": {
     "kind": "text",
     "description": "the agent's name"
    },
    "<field>": {
     "kind": "any",
     "description": "each field of data.output_schema, when data.output_mode is json or schema"
    }
   },
   "inputs": {}
  },
  {
   "type": "llm.call",
   "category": "agent",
   "label": "Model call",
   "sub": "One structured LLM call",
   "order": 8,
   "trigger": false,
   "executable": true,
   "billable": true,
   "custom": false,
   "palette": true,
   "custom_tail": "",
   "defaults": {
    "prompt": "",
    "system": "",
    "model_id": null,
    "output_mode": "text",
    "output_schema_json": ""
   },
   "fields": [
    {
     "key": "prompt",
     "type": "textarea",
     "rows": 6,
     "insertable": true,
     "title": "Prompt",
     "placeholder": "Extract the decisions from {{nodes.fetch.output.text}}"
    },
    {
     "key": "system",
     "type": "textarea",
     "rows": 2,
     "insertable": true,
     "title": "System prompt (optional)",
     "placeholder": "You extract structured facts and never invent them."
    },
    {
     "key": "model_id",
     "type": "string",
     "mono": true,
     "title": "Model (optional)",
     "placeholder": "leave blank to use your default"
    },
    {
     "key": "output_mode",
     "type": "enum",
     "title": "Output",
     "options": [
      [
       "text",
       "Text"
      ],
      [
       "json",
       "JSON object"
      ],
      [
       "schema",
       "JSON Schema"
      ]
     ]
    },
    {
     "key": "output_schema_json",
     "type": "textarea",
     "mono": true,
     "rows": 6,
     "title": "Output schema (JSON Schema)",
     "placeholder": "{ \"type\": \"object\", \"properties\": { \"summary\": { \"type\": \"string\" } }, \"required\": [\"summary\"] }"
    }
   ],
   "hint": "On JSON/Schema output a reply that does not parse, or that omits a required field, FAILS the step. Partial data would let a downstream condition read a missing field, evaluate false and take the wrong branch silently.",
   "output_sample": {
    "text": "model reply",
    "model": "Model name"
   },
   "outputs": {
    "text": {
     "kind": "text",
     "description": "the model's answer"
    },
    "model": {
     "kind": "text",
     "description": "the model's name"
    },
    "<field>": {
     "kind": "any",
     "description": "each field of the declared output schema, when data.output_mode is json or schema"
    }
   },
   "inputs": {}
  },
  {
   "type": "vision.model",
   "category": "vision",
   "label": "Find objects",
   "sub": "Run a vision model on an image",
   "order": 9,
   "trigger": false,
   "executable": true,
   "billable": true,
   "custom": false,
   "palette": true,
   "custom_tail": "",
   "defaults": {
    "image": "",
    "model": "",
    "classes": "",
    "threshold": null
   },
   "fields": [
    {
     "key": "image",
     "type": "string",
     "insertable": true,
     "mono": true,
     "title": "Image",
     "placeholder": "{{trigger.photo}}",
     "help": "An image from an earlier step or from the trigger: a manual trigger's image input, a camera event's {{trigger.image}}, or {{nodes.<id>.output.image}}."
    },
    {
     "key": "model",
     "type": "enum",
     "optionsKey": "visionModels",
     "title": "Model",
     "placeholder": "Select a model\u2026",
     "help": "A model of one of your Training Data projects (its test server or staging deployment must be running), or a ready model. Each image is paid from your balance at the model's price."
    },
    {
     "key": "classes",
     "type": "string",
     "title": "What to find",
     "placeholder": "person, car",
     "help": "SAM 3 finds exactly these. For other models it keeps only these classes. Comma separated, for example person, car. Empty keeps every class."
    },
    {
     "key": "threshold",
     "type": "number",
     "min": 0,
     "max": 1,
     "title": "Least confidence (optional)",
     "placeholder": "the model's own"
    }
   ],
   "hint": "A Test run does not call the model and charges nothing: it shows an empty answer. Use Run to find objects on a real image.",
   "output_sample": {
    "detections": {
     "kind": "detections",
     "items": [
      {
       "class": "person",
       "score": 0.91,
       "box": [
        10,
        20,
        110,
        220
       ],
       "polygon": null
      }
     ]
    },
    "count": 1,
    "classes": {
     "person": 1
    },
    "image": {
     "kind": "image",
     "id": "(image)"
    }
   },
   "outputs": {
    "detections": {
     "kind": "detections",
     "description": "what the model found, in the image's pixels"
    },
    "count": {
     "kind": "number",
     "description": "how many objects were found"
    },
    "classes": {
     "kind": "object",
     "description": "how many of each class"
    },
    "image": {
     "kind": "image",
     "description": "the image the model looked at"
    },
    "cost_usd": {
     "kind": "number",
     "description": "what the call cost"
    }
   },
   "inputs": {
    "image": [
     "image"
    ]
   }
  },
