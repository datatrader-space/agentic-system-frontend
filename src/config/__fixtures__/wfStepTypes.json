  {
   "type": "trigger.training.stream_event",
   "category": "trigger",
   "label": "Camera event",
   "sub": "A camera rule matched",
   "order": 6,
   "trigger": true,
   "executable": true,
   "billable": false,
   "custom": false,
   "palette": true,
   "custom_tail": "",
   "defaults": {
    "source": null,
    "rule": null,
    "source_name": ""
   },
   "fields": [
    {
     "type": "note",
     "text": "Starts when a rule on this camera matches what a model finds, at most once in the rule's cooldown. Read the event as {{trigger.source.name}}, {{trigger.matched}} and {{trigger.frame_time}}. {{trigger.image}} is the frame, for a vision step. A step opens the frame with {{trigger.snapshot_url}} (it works for 15 minutes after the run starts); {{trigger.snapshot_link}} is for a signed-in person."
    },
    {
     "key": "source",
     "type": "number",
     "min": 1,
     "title": "Camera id",
     "placeholder": "from the camera's page in Training Data"
    },
    {
     "key": "rule",
     "type": "number",
     "min": 1,
     "title": "Rule id (optional)",
     "placeholder": "any rule of the camera"
    }
   ],
   "hint": "Publish the workflow to have it start. It starts only for a camera of this workflow's workspace.",
   "output_sample": {
    "event": 0,
    "source": {
     "id": 0,
     "name": "Camera"
    },
    "matched": {
     "person": 1
    },
    "frame_time": "2026-11-18T09:00:00+00:00",
    "image": {
     "kind": "image",
     "event": 0
    },
    "snapshot_link": "(link)",
    "snapshot_url": "(15-minute link)"
   },
   "outputs": {
    "text": {
     "kind": "text",
     "description": "empty"
    },
    "trigger": {
     "kind": "object",
     "description": "the camera event (event, source {id, name}, rule, frame_time, matched, answer, image, snapshot_link, snapshot_url)"
    }
   },
   "inputs": {}
  },
  {
   "type": "agent.run",
   "category": "agent",
   "label": "Run agent",
   "sub": "Run an AgentProfile",
   "order": 7,
   "trigger": false,
   "executable": true,
   "billable": true,
   "custom": true,
   "palette": true,
   "custom_tail": "",
   "defaults": {
    "prompt": "",
