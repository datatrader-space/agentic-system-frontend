  {
   "type": "trigger.connector",
   "category": "trigger",
   "label": "Connector event",
   "sub": "A connected account fires",
   "order": 5,
   "trigger": true,
   "executable": true,
   "billable": false,
   "custom": false,
   "palette": true,
   "custom_tail": "connectorUrl",
   "defaults": {
    "provider": "",
    "connection": "",
    "event_type": "",
    "filters": {}
   },
   "fields": [
    {
     "key": "provider",
     "type": "string",
     "title": "Provider",
     "placeholder": "github / highlevel"
    },
